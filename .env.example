# Hermes Agent — secrets template.
#
# Copy to the host as ~/.hermes/.env (NEVER commit the real file).
# The container reads this from the mounted /opt/data. Fill in only the
# providers you actually use in config.yaml (model + fallback_providers).

# --- LLM providers ----------------------------------------------------------
# NOTE (2026-07): the live deployment now uses CLAUDE PRO via OAuth, set with
# `hermes auth add anthropic --type oauth` — that stores a token under ~/.hermes,
# NOT an API key here. Gemini has been dropped. The keys below are only needed
# if you route to those providers in config.yaml.
#
# Google Gemini — key names (either works); https://aistudio.google.com
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Anthropic API KEY — NOT the same as the Claude Pro OAuth login above. Leave
# unset unless you specifically add a pay-per-token Anthropic key to config.yaml.
# ANTHROPIC_API_KEY=

# --- Messaging --------------------------------------------------------------
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Container user ---------------------------------------------------------
# uid/gid of the unprivileged `hermes-runner` user that owns ~/.hermes AND the
# rootless Podman socket. Must be 1000 (or whatever `id -u hermes-runner` says)
# so the gateway can access the socket. `chown -R 1000:1000 ~/.hermes` to match.
HERMES_UID=1000
HERMES_GID=1000

# --- Code-execution backend -------------------------------------------------
# Rootless Podman socket for `terminal.backend: docker`. Must match the socket
# path bind-mounted in docker-compose.yml. NEVER point this at the root
# /var/run/docker.sock — that would be root-equivalent.
DOCKER_HOST=unix:///run/user/1000/podman/podman.sock

# ============================================================================
# COMPOSE / STACK-LEVEL vars — these are NOT copied to ~/.hermes/.env.
# They are read by docker-compose.yml for ${...} substitution at deploy time.
# Set them as Portainer STACK environment variables (or, for `docker compose`
# from the CLI, in a .env file next to docker-compose.yml).
# ============================================================================

# Groq API key — the memory-EXTRACTION LLM for the supermemory service (it
# distills chat turns into stored facts; it is NOT the chat model). Free tier:
# https://console.groq.com . The supermemory container refuses to start without
# it. Keep it out of git (this file's real counterpart is gitignored).
GROQ_API_KEY=
